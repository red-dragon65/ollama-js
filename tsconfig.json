{
  "compilerOptions": {
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "module": "ES2022",
    "outDir": "./dist",
    "target": "ES6",
    "sourceMap": true,
    "lib": [
      "es6",
      "es2018.asyncgenerator",
      "dom"
    ]
  },
  "ts-node": {
    "swc": true,
    "esm": true,
  },
  "include": [
    "./src/**/*.ts",
    "examples/tools/*"
  ],
  "exclude": [
    "node_modules"
  ],
}